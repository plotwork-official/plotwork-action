flow "ci" direction=right desc="6 jobs of the ci workflow, started by a push to main, next or a pull request or a manual run, in the order their needs set, imported from GitHub Actions."

node on terminal "Push or pull request or manual run"
node dist step "dist matches its checksums" sub="ubuntu-latest, 4 steps"
node check step "check" sub="ubuntu-latest, 12 steps"
node sync step "sync" sub="ubuntu-latest, 4 steps"
node validate step "validate" sub="ubuntu-latest, 4 steps"
node render step "render" sub="ubuntu-latest, 5 steps"
node inputs step "inputs" sub="ubuntu-latest, 4 steps"

on -> dist
on -> check
on -> sync
on -> validate
